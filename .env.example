# Copy this file to ".env" and fill in your keys. Never commit the real .env file.

# --- Answers (chat model) -----------------------------------------------------
# groq   = free API, no credit card: create a key at https://console.groq.com/keys  (recommended)
# gemini = Google Gemini API (only free if your Google project has the free tier)
# openai = any OpenAI-compatible server, e.g. a local Ollama: OPENAI_BASE_URL=http://localhost:11434/v1
# auto   = the first one above that has a key
# Without any key the app still runs, but answers are quoted from Wikipedia instead of in character.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Tried in order: when one model hits its free daily limit, the next one answers.
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,allam-2-7b

GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODELS=qwen2.5:7b

# Fully vowelled answers (tashkeel) so the avatar's lips follow the real Arabic vowels
LLM_DIACRITICS=true

# --- Voice (text-to-speech) --------------------------------------------------
# auto       = ElevenLabs if a key is set, otherwise free Microsoft Edge voices
# edge       = always the free Edge voices (no key needed)
# elevenlabs = ElevenLabs only (paid)
# browser    = no server voice; the browser's built-in speech is used
TTS_ENGINE=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EDGE_TTS_RATE=-5%

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=*
RAG_TOP_K=4
